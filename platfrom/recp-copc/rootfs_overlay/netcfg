reset_netswitch() {
	cpld wr 0x30 0x0;
	sleep 1;
	cpld wr 0x30 0xf;
}

reset_copc_netswitch() {
	i2cset -y -f 0 0x20 3  0x0f
	sleep 1;
	i2cset -y -f 0 0x20 3  0x0c
}



#ifconfig eth1 192.168.10.132
echo "config net switch" >> /tmp/boot.log
# reset_netswitch
reset_copc_netswitch
for idx in $(seq 1 5);do
	netcfg_dsdt -board sdx_copc -slot $SLOT_ID >> /tmp/netcfg.log
	if [ $? -ne 0 ];then
		echo "config net switch failed trytime $idx" >> /tmp/boot.log
		# reset_netswitch
        reset_copc_netswitch
        /script/sw_check.sh >> /tmp/mdio_check
		usleep 10000
	else
		echo "config net switch success" >> /tmp/boot.log
		break;
	fi
done
if [ $idx -eq 5 ];then
    echo "config net switch failed with all retry" >> /tmp/boot.log
    /script/netcfg_later.sh
else
    #get board ID for config
    # BOARD_ID=`cpld rd 0xfe00 | cut -d " " -f 2`
    BOARD_ID=0
    if [ $BOARD_ID -eq 12 ];then
        config_net_lc02v1
    elif [ $BOARD_ID -eq 13 ];then
        config_net_lc02v2
    elif [ $BOARD_ID -eq 14 ]; then
        config_net_lc03
    elif [ $BOARD_ID -eq 15 ]; then
        config_net_lc03
    elif [ $BOARD_ID -eq 21 ]; then
        config_net_lcb
        cpld wr 0x20 0x1f
    elif [ $BOARD_ID -eq 0  ]; then
	    config_net_copc
    else
        error_log "BOARD_ID $BOARD_ID ,phy no init" 
    fi
fi
exit 0

