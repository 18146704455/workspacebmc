#!/bin/bash

hextoip() {
    hex=$1
    ip1=`printf "%d" 0x${hex:6:2}`
    ip2=`printf "%d." 0x${hex:4:2}`
    ip3=`printf "%d." 0x${hex:2:2}`
    ip4=`printf "%d." 0x${hex:0:2}`
    ip=$ip4$ip3$ip2$ip1
    echo $ip
}

iptohex() {
    IFS=.
    for str in $1
    do
        printf  "%02X" $str
    done
}

echo 304 > /sys/class/gpio/export
echo 305 > /sys/class/gpio/export
echo 306 > /sys/class/gpio/export
echo 307 > /sys/class/gpio/export
echo 308 > /sys/class/gpio/export
echo 309 > /sys/class/gpio/export
echo 310 > /sys/class/gpio/export
echo 311 > /sys/class/gpio/export

echo 320 > /sys/class/gpio/export
echo 332 > /sys/class/gpio/export
echo 333 > /sys/class/gpio/export
echo 334 > /sys/class/gpio/export

echo in > /sys/class/gpio/gpio304/direction
echo in > /sys/class/gpio/gpio305/direction
echo in > /sys/class/gpio/gpio306/direction
echo in > /sys/class/gpio/gpio307/direction
echo in > /sys/class/gpio/gpio308/direction
echo in > /sys/class/gpio/gpio309/direction
echo in > /sys/class/gpio/gpio310/direction
echo in > /sys/class/gpio/gpio311/direction

echo in > /sys/class/gpio/gpio320/direction
echo in > /sys/class/gpio/gpio332/direction
echo in > /sys/class/gpio/gpio333/direction
echo in > /sys/class/gpio/gpio334/direction


slot_bit0=`cat /sys/class/gpio/gpio334/value |awk '{print}'`
slot_bit1=`cat /sys/class/gpio/gpio333/value |awk '{print}'`
slot_bit2=`cat /sys/class/gpio/gpio332/value |awk '{print}'`
slot_bit3=`cat /sys/class/gpio/gpio320/value |awk '{print}'`
slot_id_tmp=$slot_bit0$slot_bit1$slot_bit2$slot_bit3
SLOT_ID="$((2#$slot_id_tmp))"
echo $SLOT_ID

#SLOT_ID=`cpld rd 0xfe21 | cut -d " " -f 2`

local_ipaddr=`fw_printenv local_ipaddr   `
local_netmask=`fw_printenv local_netmask  `
local_gateway=`fw_printenv local_gateway  `
local_ipsrc=`fw_printenv local_ipsrc    `
local_mac=`fw_printenv local_mac      `

[ -z $local_ipaddr ] && local_ipaddr=172.16.3.50
[ -z $local_netmask ] && local_netmask=255.255.255.0
[ -z $local_gateway ] && local_gateway=172.16.3.1
[ -z $local_mac ]   && local_mac=58:41:72:68:00:01
[ -z $local_ipsrc ]   && local_ipsrc=STATIC

#IPADDR=${local_ipaddr#*=}${SLOT_ID:1:1}
local_ipaddr=${local_ipaddr#*=}
BASE_IP_HEX=$(iptohex $local_ipaddr)
let "IPADDR=0x$BASE_IP_HEX + $SLOT_ID"
let "MAC_END=0x21 + $SLOT_ID * 6 + 0"
IPADDR=$(hextoip $(printf "%x" $IPADDR))
MAC_END=$(printf "%02x" $MAC_END)

IPSRC=${local_ipsrc#*=}
NETMASK=${local_netmask#*=}
GATEWAY=${local_gateway#*=}
tmp_mac=${local_mac%:*}:$MAC_END
MAC=${tmp_mac#*=}

ETH_CONFIG=/etc/sysconfig/ifconfig.eth0

echo "ONBOOT=yes" > ${ETH_CONFIG}
echo "IFACE=eth0" >> ${ETH_CONFIG}
echo "SERVICE=ipv4-static" >> ${ETH_CONFIG}
echo "IP=$IPADDR" >> ${ETH_CONFIG}
echo "PREFIX=24" >>${ETH_CONFIG}
echo "HWADDR=$MAC" >> ${ETH_CONFIG}

[ -x /etc/sysconfig/init.sh ] && /etc/sysconfig/init.sh || echo "0" >/dev/null
ifup eth0
