/*
 * I2C bus reserved for communication with COM-E.
 */
&i2c0 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};

/*
 * I2C bus to Line Cards and Fabric Cards.
 */
&2c1 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};

/*
 * I2C bus to Power Distribution Board.
 */
&i2c2 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;

    24c64@50{
        compatible="atmel,24c64";
        reg=<0x50>;
        //wp
    };
};

/*
 * I2c bus connected with temperature sensors on CMM.
 */
&i2c3 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
    tmp75@2a{
        compatible="tmp75";
        reg=<0x2a>;
    };
    tmp75@2e{
        compatible="tmp75";
        reg=<0x2e>;
    };
    tmp75@36{
        compatible="tmp75";
        reg=<0x36>;
    };
    tmp75@4d{
        compatible="tmp75";
        reg=<0x4d>;
    };
    tmp75@4e{
        compatible="tmp75";
        reg=<0x4e>;
    };
    max1617@2b{
        compatible="max1617";
        reg=<0x2b>;
    };
};

/*
 * I2C bus reserved for communication with COM-E.
 */
&i2c4 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};

/*
 * I2c bus connected with ADM1278.
 */
&i2c5 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
    ADM1278@10{
        compatible="adm1278";
        reg=<0x10>;
    };
};

/*
 * I2c bus connected with I/O Expander.
 */
&i2c6 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};

/*
 * I2c bus connected with I/O Expander and EPROMs.
 */
&i2c7 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
    tps53667@60{
        compatible="tps53667";
        reg=<0x60>;
    };
};

/*
 * I2C bus to Fan Control Board.
 */
&i2c8 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};
&i2c9 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};
&i2c10 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};
&i2c11 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
    IR35215@47{
        compatible="ir35215";
        reg=<0x47>;
    };
};
/**/
&i2c12 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};
/*
 * I2C bus to CMM CPLD.
 */
&i2c13 {
	status = "okay";
	base-clock-divisor = <4>;
	clock-low-width = <7>;
	clock-high-width = <7>;
};

&adc {
	status = "okay";
};

